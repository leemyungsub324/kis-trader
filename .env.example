# 복사해서 사용: cp .env.example .env  (그리고 chmod 600 .env)
# .env 는 절대 git 에 올리지 마세요. 값은 직접 채우세요.

# ── 모드 ─────────────────────────────────────────────
# paper(모의투자) 또는 live(실전투자). live 는 아래 LIVE_CONFIRM 이 맞아야 시작됩니다.
TRADING_MODE=paper
# true 이면 실제 주문 전송 없이 로그/DB 에만 기록합니다. 기본값 true.
# live + DRY_RUN=true 는 '실전 계좌 조회/관찰만' 하는 안전한 첫 단계입니다.
DRY_RUN=true
# 실전 확인 문구: LIVE- + 실전 계좌번호 뒤 4자리 (예: 계좌 12345678 -> LIVE-5678)
LIVE_CONFIRM=

# ── KIS 실전투자 인증 (비밀, TRADING_MODE=live 일 때만 사용) ──
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=
KIS_LIVE_ACCOUNT_PRODUCT_CODE=01

# ── KIS 모의투자 인증 (비밀) ─────────────────────────
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
# 계좌번호 앞 8자리 / 뒤 2자리(상품코드, 보통 01)
KIS_PAPER_ACCOUNT_NO=
KIS_PAPER_ACCOUNT_PRODUCT_CODE=01

# ── 텔레그램 알림 (비워두면 알림 비활성) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 대상 종목 (쉼표 구분, 6자리 코드) ────────────────
WATCHLIST=005930

# ── 안전장치 한도 (기본값은 예시이니 직접 조정) ──────
MAX_ORDER_AMOUNT_KRW=500000
MAX_ORDER_QTY=100
MAX_POSITION_PER_SYMBOL_KRW=1000000
MAX_TOTAL_POSITION_KRW=3000000
DAILY_MAX_LOSS_KRW=100000
STOP_LOSS_PCT=5.0
MAX_CONSECUTIVE_ERRORS=3
# 하루 매수 주문 누적 한도(원). 0 = 제한 없음. 매도 후 재매수도 누적
DAILY_MAX_BUY_KRW=0

# ── 전략 ─────────────────────────────────────────────
# observe = 주문 없음(기본) / composite = 이동평균+일목균형표+RSI 종합점수(0~100) 매매
STRATEGY=observe
# 매수 점수 기준(필수 필터도 통과해야 함). 85점 이상이면 예산 100%, 그 외 50%
STRATEGY_BUY_SCORE=70
# 보유 종목 점수가 이 값 미만이면 전량 매도
STRATEGY_SELL_SCORE=40
# 1회 매수 예산(원). 0 이면 MAX_ORDER_AMOUNT_KRW 사용
STRATEGY_BUY_KRW=0
# 장 초반 변동성 회피: 이 시각 이후에만 신규 매수
STRATEGY_ENTRY_AFTER=09:10
# 1시간봉 데모: true 면 1시간봉으로 매시 판단 (demo_hourly.py)
# DEMO_DATE: 하루(YYYY-MM-DD) 또는 기간(YYYY-MM-DD~YYYY-MM-DD). 그 날짜에만 전략 주문, 매일 15:15 청산
DEMO_HOURLY=false
DEMO_DATE=

# ── 동작 ─────────────────────────────────────────────
POLL_INTERVAL_SEC=60
# 모의투자 초당 호출 제한이 낮아 보수적으로 1초 이상 권장
API_MIN_INTERVAL_SEC=1.0
# 주문 허용 시간 (KST). 15:20 이후는 동시호가라 기본 제외
ORDER_START=09:00
ORDER_END=15:20
# 추가 휴장일(쉼표 구분, YYYY-MM-DD). 휴장일 API 와 별개의 수동 보강용
EXTRA_HOLIDAYS=
# 일일 요약 전송 시각 (KST)
DAILY_SUMMARY_TIME=15:40
LOG_LEVEL=INFO
